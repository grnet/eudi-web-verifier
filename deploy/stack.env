# Non-secret deploy configuration, committed so it is reviewable in a diff.
# This stack has no secrets beyond the SSH key; see deploy/README.md.

VERIFIER_UI_HOST=demo.eudiw.grnet.gr

# A sibling of the backend's /verifier, not a child: the backend already holds
# /verifier/ui, /verifier/wallet and /verifier/utilities. Trailing slash, as
# with every other VIRTUAL_PATH here.
#
# /verifier/ for the UI and /verifier-api/ for the backend would read better and
# match the issuer pair's /issuer/ and /frontend/, but the backend's publicUrl
# is signed into every request object it has issued, so moving it is not free.
VERIFIER_UI_PATH=/verifier-ui/

# Angular bakes <base href="/"> into index.html, so behind a prefix the browser
# resolves assets to the host root, which is the status list. nginx rewrites it
# per request from this value. Must match VERIFIER_UI_PATH, slashes included.
BASE_HREF=/verifier-ui/

# Where the browser reaches the backend. Public URL, not a container name: this
# stack is standalone and only the browser dereferences it. No trailing slash,
# the app concatenates "/..." onto it.
VERIFIER_API_URL=https://demo.eudiw.grnet.gr/verifier

LETSENCRYPT_EMAIL=devops-rnd@grnet.gr
